{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity Armed Session",
  "type": "object",
  "required": ["schema", "status", "session_id", "host", "auto_successor", "armed_at"],
  "properties": {
    "schema": {"const": 1},
    "status": {
      "enum": ["armed", "handoff_pending", "transferred", "disarmed"]
    },
    "session_id": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "goal": {"type": "string"},
    "instructions": {"type": "string"},
    "auto_successor": {"type": "boolean"},
    "armed_at": {"type": "integer"},
    "inherited_from": {"type": ["string", "null"]},
    "handoff_id": {"type": "integer"},
    "handoff_path": {"type": "string"},
    "label": {"type": "string", "description": "Session chain name; sessions are labelled \"Session <label> <generation>\"."},
    "generation": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "1.0 for the first session, then 1.1, 1.2, ..."}
  },
  "additionalProperties": true
}
