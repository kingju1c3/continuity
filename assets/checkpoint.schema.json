{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity checkpoint",
  "type": "object",
  "required": [
    "goal",
    "summary",
    "next_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accomplished": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
